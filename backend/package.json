{
  "name": "@bsv/kvstore-services-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BSV KVStore Lookup Service Backend",
  "module": "dist/esm/mod.js",
  "types": "dist/types/mod.d.ts",
  "files": [
    "PATENTS",
    "NOTICE",
    "dist",
    "src",
    "mod.ts",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/mod.d.ts",
      "import": "./dist/esm/mod.js"
    },
    "./*.ts": {
      "types": "./dist/types/src/*.d.ts",
      "import": "./dist/esm/src/*.js"
    }
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:build": "npm run build && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "ts-standard --fix src/**/*.ts",
    "build": "tsc -b",
    "prepublish": "npm run build",
    "doc": "ts2md --inputFilename=mod.ts --outputFilename=API.md --filenameSubstring=API --firstHeadingLevel=1"
  },
  "author": "BSV Association",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "11.3.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2",
    "ts2md": "^0.2.0",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@bsv/overlay": "2.7.0",
    "@bsv/overlay-express": "2.8.0",
    "@bsv/sdk": "4.0.1",
    "@bsv/wallet-toolbox-client": "2.15.3",
    "mongodb": "7.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@bsv/sdk": "$@bsv/sdk",
    "@bsv/overlay": "$@bsv/overlay",
    "@bsv/wallet-toolbox-client": "$@bsv/wallet-toolbox-client"
  }
}
